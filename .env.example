# CricketIQ Environment Configuration (Example)
# Copy this file to .env and customize for your environment.
# NEVER commit real API keys or credentials.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database Configuration
# Local development default: sqlite:///./cricketiq/data/cricketiq.db
# Production PostgreSQL: postgresql+asyncpg://cricketiq_user:secret_password@localhost:5432/cricketiq
DATABASE_URL=sqlite:///./cricketiq/data/cricketiq.db

# LLM Provider Configuration (Optional for ingestion/search; required for Phase 4 answer generation)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Ingestion & Source Policy
DATA_DIR=./cricketiq/data
ALLOW_OFFICIAL_DOMAINS_ONLY=true
